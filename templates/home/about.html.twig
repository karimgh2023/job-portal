{% extends 'template_job.html.twig' %}

{% block body %}
<!-- About Start -->
<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.1s">
                <div class="row g-0 about-bg rounded overflow-hidden">
                    <div class="col-6 text-start">
                        <img class="img-fluid w-100" src="{{ asset('images/about-1.jpg') }}" alt="À Propos 1">
                    </div>
                    <div class="col-6 text-start">
                        <img class="img-fluid" src="{{ asset('images/about-2.jpg') }}" style="width: 85%; margin-top: 15%;" alt="À Propos 2">
                    </div>
                    <div class="col-6 text-end">
                        <img class="img-fluid" src="{{ asset('images/about-3.jpg') }}" style="width: 85%;" alt="À Propos 3">
                    </div>
                    <div class="col-6 text-end">
                        <img class="img-fluid w-100" src="{{ asset('images/about-4.jpg') }}" alt="À Propos 4">
                    </div>
                </div>
            </div>
            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.5s">
                <h1 class="mb-4">Nous vous aidons à trouver le meilleur emploi et à dénicher les talents</h1>
                <p class="mb-4">Facilitez votre recrutement ou votre recherche d'emploi grâce à notre plateforme moderne et intuitive, conçue pour connecter les meilleurs profils avec les entreprises les plus innovantes.</p>
                <p><i class="fa fa-check text-primary me-3"></i>Offres d'emploi vérifiées et mises à jour quotidiennement</p>
                <p><i class="fa fa-check text-primary me-3"></i>Accompagnement personnalisé pour les candidats</p>
                <p><i class="fa fa-check text-primary me-3"></i>Outils de recrutement avancés pour les entreprises partenaires</p>
                <a class="btn btn-primary py-3 px-5 mt-3" href="{{ path('app_contact') }}">Contactez-nous</a>
            </div>
        </div>
    </div>
</div>
<!-- About End -->
{% endblock %}
